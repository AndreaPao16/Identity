@page
@model RegisterModel
@{
}
<div>
<form asp-route-returnUrl="@Model.ReturnUrl"method="post">

    <div>
        <label>Primer Nombre</label>
        <input asp-for="Register.PrimerNombre" />
    </div>

    <div>
        <label>Segundo Nombre (Opcional)</label>
        <input asp-for="Register.SegundoNombre" />
    </div>

    <div>
        <label>Apellido</label>
        <input asp-for="Register.Apellido" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Register.Email" />
    </div>

    <div>
        <label>Password</label>
        <input asp-for="Register.Password" type="password" />
    </div>

    <div>
        <label>Verificar Password</label>
        <input asp-for="Register.Password2" type="password" />
    </div>


    <button type="submit"> Registrar</button>
</form>


</div>